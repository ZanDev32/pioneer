{
  "name": "@zandev32/pioneer",
  "version": "0.1.0",
  "description": "Standalone MCP server for pioarduino/PlatformIO — build, upload, clean, and more for embedded firmware projects",
  "type": "module",
  "bin": {
    "pioneer": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "lint": "eslint src/"
  },
  "keywords": [
    "mcp",
    "platformio",
    "pioarduino",
    "embedded",
    "firmware",
    "espressif",
    "esp32",
    "arduino",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pioarduino/pioarduino-vscode-ide"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "vitest": "5.1.0"
  }
}
