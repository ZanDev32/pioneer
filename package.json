{
  "name": "pioneer",
  "version": "0.1.0",
  "description": "Standalone MCP server for pioarduino/PlatformIO — build, upload, clean, and more for embedded firmware projects",
  "type": "module",
  "bin": {
    "pioneer": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "mcp",
    "platformio",
    "pioarduino",
    "embedded",
    "firmware",
    "espressif",
    "esp32",
    "arduino",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pioarduino/pioarduino-vscode-ide"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  }
}
